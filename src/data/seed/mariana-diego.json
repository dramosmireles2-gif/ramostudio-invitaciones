  "mensajes": [
    {
      "id": "msg_01",
      "eventoId": "evt_demo_md",
      "familiaId": "fam_01",
      "autor": "Familia García Pérez",
      "texto": "¡Ahí estaremos! Nos llena de alegría verlos dar este paso. Con cariño, los García Pérez.",
      "cuando": {
        "dias": 2,
        "hora": "19:50"
      }
    },
    {
      "id": "msg_02",
      "eventoId": "evt_demo_md",
      "familiaId": "fam_03",
      "autor": "Ana y Luis López",
      "texto": "Con mucho cariño, cuenten con nosotros para bailar toda la noche.",
      "cuando": {
        "dias": 4,
        "hora": "19:34"
      }
    },
    {
      "id": "msg_03",
      "eventoId": "evt_demo_md",
      "familiaId": "fam_05",
      "autor": "Familia Gutiérrez",
      "texto": "Diego, tu abuela ya está escogiendo vestido. Ahí nos vemos.",
      "cuando": {
        "dias": 7,
        "hora": "19:48"
      }
    },
    {
      "id": "msg_04",
      "eventoId": "evt_demo_md",
      "familiaId": "fam_26",
      "autor": "Paola y Bruno Cárdenas",
      "texto": "¡Qué emoción! Ya compramos el vuelo desde Monterrey.",
      "cuando": {
        "dias": 0,
        "hora": "09:39"
      }
    },
    {
      "id": "msg_05",
      "eventoId": "evt_demo_md",
      "familiaId": "fam_28",
      "autor": "Dra. Soto",
      "texto": "Lamentamos mucho no poder acompañarlos; estaremos fuera del país. Les deseamos toda la felicidad.",
      "cuando": {
        "dias": 5,
        "hora": "09:53"
      }
    },
    {
      "id": "msg_06",
      "eventoId": "evt_demo_md",
      "familiaId": "fam_48",
      "autor": "Familia Benavides",
      "texto": "Les mandamos un abrazo enorme; ese fin de semana tenemos otra boda en Saltillo.",
      "cuando": {
        "dias": 5,
        "hora": "19:37"
      }
    }
